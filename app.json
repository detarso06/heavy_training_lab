{
  "expo": {
    "name": "Heavy Training Lab",
    "slug": "heavy-training-lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "heavytraininglab",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050504",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050504",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Heavy Training Lab",
      "shortName": "Heavy Lab",
      "themeColor": "#050504",
      "backgroundColor": "#050504"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050504",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa59e0a8-aaab-443b-8322-9716ddd29638"
      }
    },
    "owner": "detarso"
  }
}
