# Copie para .env.local (que não vai para o git) e preencha com os dados do projeto no Supabase:
# Project Settings → API (ou "Connect"): Project URL e a Publishable key (sb_publishable_...).
# A chave publishable é pública por design; quem protege os dados são as regras em supabase/schema.sql.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
